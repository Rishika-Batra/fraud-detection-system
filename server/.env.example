# ─── Server Configuration ─────────────────────────────────
PORT=5001

# ─── Security ─────────────────────────────────────────────
# Required in production (≥ 32 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change_me

# ─── Database ─────────────────────────────────────────────
# Path to the SQLite file (relative to the server/ directory).
# Use :memory: for ephemeral in-memory databases (tests use this).
DB_PATH=./db/fraud.db

# ─── Environment ──────────────────────────────────────────
# Set to 'production' when deploying. Controls static serving,
# secret enforcement, and trust proxy settings.
# NODE_ENV=production

# ─── Demo Bootstrap (hosted demos only) ──────────────────
# When ALLOW_DEMO_SEED=true AND the database is empty AND
# SEED_PASSWORD is set (≥ 12 characters), the server auto-seeds
# demo data at startup. The password is never logged.
# ALLOW_DEMO_SEED=true
# SEED_PASSWORD=YourSecureDemoPassword123

# ─── Static Client Path (optional) ───────────────────────
# Override the folder from which the built React client is served
# in production. Defaults to ../client/dist relative to server/.
# CLIENT_DIST_PATH=/absolute/path/to/client/dist
